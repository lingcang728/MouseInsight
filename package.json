{
  "name": "mouse-insight",
  "version": "0.3.0-beta.1",
  "private": true,
  "description": "Mouse Insight",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsc --noEmit && node tests/frontend_logic.test.mjs && node tests/check_release_version.test.mjs && node scripts/check-release-version.mjs && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check:release-version": "node scripts/check-release-version.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6",
    "vite": "^6"
  }
}